/** Backend آموزشگاه تخت جمشید — Google Sheets + Apps Script.
 * قبل از انتشار: SPREADSHEET_ID را تنظیم کنید و در Project Settings > Script properties
 * کلید ADMIN_PASSWORD را با یک رمز طولانی و یکتا مقداردهی کنید. شیت را عمومی نکنید.
 */
const SPREADSHEET_ID = 'PASTE_GOOGLE_SHEET_ID_HERE';
const LEADS_SHEET = 'درخواست‌ها';
const EVENTS_SHEET = 'آمار سایت';
const LEAD_HEADERS = ['زمان ثبت','نوع فرم','نام و نام خانوادگی','شماره موبایل','سن','جنسیت مربی','نوع درخواست','وضعیت پرداخت','آدرس صفحه','وضعیت پیگیری','تاریخ پیشنهادی','بازه زمانی','توضیحات'];
const EVENT_HEADERS = ['زمان','رویداد','صفحه','شناسه نشست ناشناس'];
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
function safeText_(v,n){return String(v==null?'':v).replace(/[<>]/g,'').trim().slice(0,n)}
function getSheet_(name,headers){if(SPREADSHEET_ID==='PASTE_GOOGLE_SHEET_ID_HERE')throw new Error('ابتدا شناسه Google Sheet را در google-apps-script.gs تنظیم کنید.');const ss=SpreadsheetApp.openById(SPREADSHEET_ID);let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(sh.getLastRow()===0)sh.appendRow(headers);return sh}
function doGet(e){const p=e&&e.parameter||{};if(p.action==='admin')return HtmlService.createHtmlOutputFromFile('Admin').setTitle('پنل مدیریت آموزشگاه تخت جمشید').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.DEFAULT);return ContentService.createTextOutput('Takhteh Jamshid backend is ready. Admin: add ?action=admin');}
function doPost(e){try{const p=e&&e.parameter||{};if(p.action==='event'){const event=safeText_(p.event,50);if(!['page_view','click_call','click_register','click_lesson','exam_start','exam_complete'].includes(event))return json_({ok:false});getSheet_(EVENTS_SHEET,EVENT_HEADERS).appendRow([new Date(),event,safeText_(p.page,250),safeText_(p.session,80)]);return json_({ok:true})}
const sh=getSheet_(LEADS_SHEET,LEAD_HEADERS);sh.appendRow([new Date(),safeText_(p.formType,50),safeText_(p.fullName,100),safeText_(p.mobile||p.phone,30),safeText_(p.age,3),safeText_(p.instructorGender,30),safeText_(p.registrationType||p.lessonType,80),safeText_(p.paymentStatus,100),safeText_(p.pageUrl,250),'جدید',safeText_(p.preferredDate,30),safeText_(p.preferredTime,30),safeText_(p.notes,500)]);return json_({ok:true});}catch(err){return json_({ok:false,error:String(err)})}}
function adminLogin(password){const expected=PropertiesService.getScriptProperties().getProperty('ADMIN_PASSWORD');if(!expected||expected.length<12)throw new Error('مدیر: ابتدا Script Property با نام ADMIN_PASSWORD و رمز حداقل ۱۲ کاراکتری تنظیم شود.');if(String(password||'')!==expected)throw new Error('رمز عبور نادرست است.');const token=Utilities.getUuid()+Utilities.getUuid();CacheService.getScriptCache().put('admin:'+token,'1',21600);return {token:token,expiresIn:21600}}
function assertAdmin_(token){if(!token||CacheService.getScriptCache().get('admin:'+token)!=='1')throw new Error('نشست منقضی شده است؛ دوباره وارد شوید.')}
function adminGetDashboard(token){assertAdmin_(token);const leads=getSheet_(LEADS_SHEET,LEAD_HEADERS),events=getSheet_(EVENTS_SHEET,EVENT_HEADERS);const lr=leads.getLastRow(),er=events.getLastRow();const leadRows=lr>1?leads.getRange(2,1,lr-1,LEAD_HEADERS.length).getValues():[];const eventRows=er>1?events.getRange(2,1,er-1,EVENT_HEADERS.length).getValues():[];return {leads:leadRows.map((r,i)=>({row:i+2,date:r[0] instanceof Date?r[0].toISOString():String(r[0]),type:r[1],name:r[2],mobile:r[3],age:r[4],instructor:r[5],requestType:r[6],status:r[9]||'جدید',preferredDate:r[10],preferredTime:r[11],notes:r[12]})).reverse().slice(0,300),stats:{leads:leadRows.length,newLeads:leadRows.filter(r=>!r[9]||r[9]==='جدید').length,events:eventRows.length,callClicks:eventRows.filter(r=>r[1]==='click_call').length,registerClicks:eventRows.filter(r=>r[1]==='click_register').length}}}
function adminUpdateLead(token,row,status){assertAdmin_(token);const allowed=['جدید','تماس گرفته شد','ثبت‌نام نهایی شد','لغو شد'];if(!allowed.includes(status))throw new Error('وضعیت نامعتبر است.');const sh=getSheet_(LEADS_SHEET,LEAD_HEADERS);row=Number(row);if(row<2||row>sh.getLastRow())throw new Error('ردیف نامعتبر است.');sh.getRange(row,10).setValue(status);return {ok:true}}
